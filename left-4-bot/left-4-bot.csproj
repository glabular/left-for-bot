<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>left_4_bot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>fd88bcde-4ec3-469b-b872-c634e6827a0d</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreRCON" Version="5.*" />
		<PackageReference Include="FluentFTP" Version="53.*" />
		<PackageReference Include="L4D2PlayStats" Version="1.0.0.58" />
		<PackageReference Include="Telegram.Bot" Version="22.*" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.*" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.*" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Configuration\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="left-4-bot.Tests" />
	</ItemGroup>

</Project>
